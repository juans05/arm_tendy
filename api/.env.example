DATABASE_URL=postgres://arm:arm@localhost:5434/arm
DATABASE_URL_TEST=postgres://arm:arm@localhost:5434/arm_test
REDIS_URL=redis://localhost:6380
CUENTAS_URL=http://localhost:3001
CUENTAS_ISSUER=https://wsp-sms-api.initchange.dev
CUENTAS_AUDIENCE=https://wsp-sms.initchange.dev
WEB_ORIGIN=http://localhost:3100
# Meta / WhatsApp (misma app de Meta que Wuarikes)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# URL pública https de esta API (Meta envía aquí el webhook: ARM_PUBLIC_URL/webhooks/whatsapp)
ARM_PUBLIC_URL=
# Cifra los tokens de Meta guardados en la base
FIELD_ENCRYPTION_KEY=
# IA (API compatible con OpenAI: OpenRouter, Gemini, OpenAI u Ollama). Sin AI_BASE_URL la IA queda apagada
# y ARM funciona como bandeja humana. Ejemplo OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# Respaldo opcional si el principal falla
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Embeddings de 1536 dimensiones para la base de conocimiento (sin esto se busca por texto)
AI_EMBED_MODEL=openai/text-embedding-3-small
# Modelos con visión y audio (por defecto, AI_MODEL)
AI_VISION_MODEL=
AI_AUDIO_MODEL=
# Espera antes de responder para juntar mensajes seguidos del cliente (ms)
AGENTE_ESPERA_MS=3000

# Barrido de cada minuto (seguimientos, recordatorios, sin atender, resumen diario). 'off' lo apaga.
# BARRIDO=off

# Límite de peticiones por IP y minuto. TRUST_PROXY=true si la API corre detrás de un proxy.
# LIMITE_POR_MINUTO=300
# TRUST_PROXY=true
# Con REDIS_URL el tiempo real y el límite de peticiones se comparten entre instancias. 'off' para dejarlos en memoria.
# EVENTOS_REDIS=off
# LIMITE_REDIS=off
